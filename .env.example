# ==============================================================================
# KONFIGURASI BOT TELEGRAM & AI AGENT ABSENSI MONEV
# ==============================================================================
# Salin file ini menjadi .env dan isi nilai yang sesuai:
#   cp .env.example .env
# JANGAN pernah menyimpan token rahasia ke dalam repositori git!
# ==============================================================================

# Port aplikasi (health check dan observability)
APP_PORT=8080
APP_ENV=development

# Token Bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID Grup Telegram yang diizinkan untuk menerima pengingat Monev dan dianalisis
# Contoh: -1001234567890 (Grup supergroup biasanya diawali dengan -100)
# Pisahkan dengan koma jika lebih dari satu grup: -1001111111111,-1002222222222
TELEGRAM_ALLOWED_GROUPS=

# ID Pengguna Telegram Admin (berwenang menjalankan /setgroup, /testreminder, dsb.)
# Pisahkan dengan koma jika lebih dari satu admin: 12345678,87654321
TELEGRAM_ADMIN_USER_IDS=

# ID Grup target utama untuk Pengingat Monev otomatis
# Jika kosong, bot akan menunggu konfigurasi via perintah /setgroup di grup target
TELEGRAM_MONEV_TARGET_GROUP_ID=

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan
# Pilihan stabil: gemini-2.5-flash, gemini-3.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Konfigurasi Database PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bottele
DATABASE_PASSWORD=secretpassword
DATABASE_NAME=botteleabsensi
DATABASE_SSLMODE=disable

# URL Lengkap Database (Opsional, menggantikan DATABASE_HOST dsb jika diisi)
# DATABASE_URL=postgres://bottele:secretpassword@localhost:5432/botteleabsensi?sslmode=disable

# Zona Waktu (Wajib Asia/Jakarta)
TIMEZONE=Asia/Jakarta

# Jam Pengingat Monev (Format HH:MM, default 15:00 dan 20:00)
MONEV_REMINDER_TIME_1=15:00
MONEV_REMINDER_TIME_2=20:00

# Batas toleransi pemulihan jadwal jika server mati saat jadwal berjalan (menit)
MONEV_RECOVERY_GRACE_MINUTES=30

# Jadwal Rangkuman Harian Grup Otomatis (Format HH:MM, default 21:00 WIB)
DAILY_SUMMARY_TIME=21:00

